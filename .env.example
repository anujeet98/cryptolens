# Copy to .env.local for local development. Every value is optional: with none of them set the dashboard is fully open
# (the default for self-hosting). Authentication turns on only when DATABASE_URL, BETTER_AUTH_SECRET and at least one
# provider are all set. Never commit real values.

# --- Authentication (optional) ---
# Postgres connection string. On Neon, use the POOLED string (the host contains "-pooler").
DATABASE_URL=
# 32+ random characters used to sign sessions:   openssl rand -base64 48
BETTER_AUTH_SECRET=
# The public origin of this deployment. OAuth callbacks are <this>/api/auth/callback/<provider>.
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers: a provider is enabled only when BOTH its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# A secret that lets the deploy pipeline's smoke test past the sign-in gate (sent as the x-smoke-token header).
# Set it on the deployment AND as a GitHub secret. Leave unset to disable the bypass.
SMOKE_TOKEN=

# --- Optional link from the header logo back to a landing page ---
NEXT_PUBLIC_HOME_URL=
